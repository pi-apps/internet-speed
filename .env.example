# ---------- Brand ----------
BRAND_NAME=Internet Speed
SITE_URL=https://speed.example.com
CONTACT_EMAIL=hello@example.com
CONTACT_TELEGRAM=https://t.me/example

# ---------- Speed test widget ----------
# Hosted OpenSpeedTest. No test server of your own is needed.
SPEEDTEST_URL=https://openspeedtest.com/speedtest

# ---------- Server ----------
PORT=8080
HOST=0.0.0.0
TRUST_PROXY=1
DB_FILE=./data/internet-speed.db
HASH_SALT=replace-with-a-long-random-string
ADMIN_TOKEN=

# Pi usernames allowed into /admin, comma separated and without the @.
# Everything in the dashboard is gated on this; leave it empty and nobody can
# open it, including you.
ADMIN_USERNAMES=

# ---------- Pi Network ----------
# Two sign-in paths, chosen at runtime:
#   ordinary browser  -> Pi Sign-in (OAuth), needs PI_CLIENT_ID and a redirect URI
#   inside Pi Browser -> window.Pi.authenticate(), needs neither
PI_ENABLED=true

# Affects only the in-Pi-Browser path (Pi.init). Keep false unless testing
# through a Sandbox URL.
PI_SANDBOX=false

# "oAuth Client ID" from the Pi Sign-in section of the Developer Portal.
# Sign-in in ordinary browsers cannot work without it. It is public, not a secret.
PI_CLIENT_ID=

# Must appear character for character in the portal's Redirect URIs list.
# Left empty it is derived from SITE_URL as <SITE_URL>/signin/callback
PI_REDIRECT_URI=

# Scopes for the OAuth path. Valid values: username, wallet_address.
# The payments scope is not supported there.
#
# wallet_address is required to pay rewards: creating an App-to-User payment
# needs the recipient's public key, and Pi answers 401 missing_scope without it.
PI_SCOPES=username wallet_address

# Scopes for the SDK path. Pi's checklist requires at least username and
# payments; with username alone Pi answers "Authentication failed".
PI_SDK_SCOPES=username payments wallet_address

# Domain ownership key from the portal, served at /validation-key.txt
PI_VALIDATION_KEY=

# Session lifetime in days
PI_SESSION_DAYS=30

# Pi may render the app inside its own frame, where a Lax cookie is not sent and
# the user appears signed out immediately. SameSite=None requires HTTPS.
COOKIE_SAMESITE=none

# ---------- Donations ----------
# Server API Key from the portal. Needed only for payments, never sent to the
# browser. With this empty the donation panel stays hidden.
PI_API_KEY=

DONATIONS_ENABLED=true
DONATION_PRESETS=0.5,1,5,10
DONATION_MIN=0.01
DONATION_MAX=1000
DONATION_MEMO_MAX=50

# ---------- The two deployments ----------
# Which network this site serves: testnet or mainnet.
PI_NETWORK=testnet

# Where its counterpart lives. Each site links to the other, so set this to the
# Mainnet address on the Testnet site and to the Testnet address on the Mainnet
# one. The label is worked out automatically unless you set it.
ALT_NETWORK_URL=
ALT_NETWORK_LABEL=

# Older name for the same link, still honoured if ALT_NETWORK_URL is empty.
MAINNET_URL=
MAINNET_LABEL=Open the Mainnet site

# ---------- Daily reward (A2U payments) ----------
# The app pays the daily leaderboard winner from its own wallet.
#
# This needs the app wallet's PRIVATE SEED on the server. Treat it like cash:
# use a dedicated wallet, keep only what you intend to pay out in it, and never
# commit this file. Anyone with the seed can drain the wallet.
REWARDS_ENABLED=false
PI_WALLET_PRIVATE_SEED=

# Amount paid to the winner of each finished day
REWARD_AMOUNT=0.1
REWARD_MEMO=Daily latency champion

# A run only qualifies if at least this many targets answered. Raising it makes
# a fabricated run more work to produce.
REWARD_MIN_REACHABLE=6

# A run must take at least this long and at most this long, measured from the
# token the server issues before the run starts.
REWARD_MIN_RUN_SECONDS=6
REWARD_MAX_RUN_SECONDS=900

# Minutes to shift the day boundary away from UTC. 210 is UTC+3:30.
REWARD_DAY_OFFSET_MINUTES=0

# How long after a day ends its winner may still claim
REWARD_CLAIM_WINDOW_DAYS=7
REWARD_LEADERBOARD_SIZE=10

# Only set this if the SDK picks the wrong network: "Pi Network" or "Pi Testnet"
PI_NETWORK_PASSPHRASE=

# ---------- Pi Developer Ad Network ----------
# The app must be approved for the Ad Network in the Developer Portal first.
# PI_API_KEY is required: a rewarded view means nothing until the server has
# checked its adId against the Platform API.
ADS_ENABLED=false

# A rewarded ad can only be shown to a signed-in user, so the gate before
# sign-in uses an interstitial. The latency gate uses a rewarded ad when the
# visitor is signed in and an interstitial when they are not.
ADS_BEFORE_SIGNIN=true
ADS_BEFORE_LATENCY=true

# How long before the same gate shows another ad to the same visitor
ADS_COOLDOWN_SECONDS=300

# Leave false. When true, an action is refused if no ad can be shown - which
# punishes the visitor for a failure that is not theirs.
ADS_BLOCK_ON_FAILURE=false

# ---------- Content Security Policy ----------
# Extra origins your CDN or proxy needs, space separated.
# Cloudflare Web Analytics example:
# CSP_SCRIPT_SRC_EXTRA=https://static.cloudflareinsights.com
# CSP_CONNECT_SRC_EXTRA=https://cloudflareinsights.com
CSP_SCRIPT_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=

# ---------- Features ----------
SAVE_RESULTS=true
PUBLIC_STATS=true
GEO_PROVIDER=ip-api   # or none to disable provider lookup
